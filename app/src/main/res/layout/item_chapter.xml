<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRootLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_blue_box"
    android:padding="20dp"
    android:layout_marginVertical="6dp"
    android:descendantFocusability="blocksDescendants"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_toStartOf="@id/btnRowAction"
    android:layout_centerVertical="true"
    android:layout_marginEnd="16dp">

    <TextView
        android:id="@+id/txtChapterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtChapterSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B0C4DE"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />
</LinearLayout>

    <ImageButton
        android:id="@+id/btnRowAction"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:padding="4dp"
        android:focusable="false" android:focusableInTouchMode="false" android:contentDescription="Action Icon" />

</RelativeLayout>